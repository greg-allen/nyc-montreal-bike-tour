  <metadata><name>Poughkeepsie to Troy, NY</name><desc>95.9 mi (154.3 km), about +2,000 ft. Routed on OpenStreetMap along the official trails.</desc></metadata>
  <wpt lat="41.92746" lon="-73.91133"><name>Lunch: Bread Alone Bakery &amp; Cafe</name><desc>Mile 19.2. 45 E Market St, Rhinebeck, NY. . Breakfast and lunch daily; listed open Mondays 7 AM to 5 PM.</desc><sym>Restaurant</sym></wpt>
  <wpt lat="42.73414" lon="-73.68843"><name>Hotel: Best Western Plus Franklin Square Inn Troy/Albany</name><desc>Mile 95.9. 1 4th St, Troy, NY. (518) 274-8800. Downtown Troy.</desc><sym>Lodging</sym></wpt>
  <wpt lat="41.92749" lon="-73.91388"><name>Bike: Rhinebeck Bicycle Shop</name><desc>Mile 19.3. 10 Garden St, Rhinebeck, NY. (845) 876-4025. Repairs, parts, rentals. One block from Bread Alone. Call for hours.</desc><sym>Bike Trail</sym></wpt>
  <wpt lat="42.25278" lon="-73.79132"><name>Bike: Steiner's Sports</name><desc>Mile 48.6. 301 Warren St, Hudson, NY. (518) 828-5063. Bike sales and service. Listed Mon to Fri 10 to 6, Sat 10 to 5, Sun from 11.</desc><sym>Bike Trail</sym></wpt>
  <wpt lat="42.41800" lon="-73.67000"><name>Bike: Steiner's Sports (Valatie)</name><desc>Mile 64.5, 0.5 mi off route. 3455 Route 9, Valatie, NY. (518) 784-3663. In Valatie, just off the AHET around mile 15. Listed Mon to Wed 10 to 6, Thu and Fri 10 to 8, Sat 9 to 5, Sun 11 to 4.</desc><sym>Bike Trail</sym></wpt>
  <wpt lat="42.25407" lon="-73.79778"><name>Station: Hudson</name><desc>Mile 48.4, 0.3 mi off route.</desc><sym>Train</sym></wpt>
  <wpt lat="42.64125" lon="-73.74129"><name>Station: Albany-Rensselaer</name><desc>Mile 86.6, 0.1 mi off route.</desc><sym>Train</sym></wpt>
