<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="mtl_bike tools/build.py" xmlns="http://www.topografix.com/GPX/1/1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">
  <metadata><name>Ticonderoga, NY to Burlington, VT (via Essex ferry)</name><desc>60.7 mi (97.7 km), about +2,500 ft. Routed on OpenStreetMap along the official trails.</desc></metadata>
  <wpt lat="44.31005" lon="-73.35154"><name>Lunch: Pink Pig Cafe</name><desc>Mile 38.4. 2750 Essex Rd, Essex, NY. (518) 962-8833. Next to the ferry dock. Hours are limited in the fall (one listing shows Fri to Sun hours and closed Mon to Wed; Thursday is unclear): call ahead. The Essex Ice Cream Cafe is summer-only, and 'The Cup Cafe' from earlier drafts does not appear to exist.</desc><sym>Restaurant</sym></wpt>
  <wpt lat="44.47891" lon="-73.21788"><name>Hotel: Hotel Vermont</name><desc>Mile 60.7. 41 Cherry St, Burlington, VT. (802) 651-0080. Downtown, near the lakefront path.</desc><sym>Lodging</sym></wpt>
  <wpt lat="44.47879" lon="-73.21860"><name>Hotel: Courtyard Burlington Harbor</name><desc>Mile 60.7. 25 Cherry St, Burlington, VT. (802) 864-4700. Next door to Hotel Vermont.</desc><sym>Lodging</sym></wpt>
  <wpt lat="44.48510" lon="-73.21030"><name>Bike: Old Spokes Home</name><desc>Mile 60.7, 0.6 mi off route. 331 N Winooski Ave, Burlington, VT. (802) 863-4475. Tue to Fri 10 to 6, Sat 10 to 5; closed Sun and Mon.</desc><sym>Bike Trail</sym></wpt>
  <wpt lat="44.47600" lon="-73.21560"><name>Bike: North Star Sports</name><desc>Mile 60.3, 0.2 mi off route. 100 Main St, Burlington, VT. (802) 863-3832. Downtown bike shop near the waterfront.</desc><sym>Bike Trail</sym></wpt>
  <wpt lat="44.04761" lon="-73.45925"><name>Food: Stewart's Shops #103</name><desc>Mile 15.0. 4308 Main St, Port Henry, NY. (518) 546-3025. Guaranteed food and water on Day 5. Top up here.</desc><sym>Convenience Store</sym></wpt>
  <wpt lat="44.04233" lon="-73.45883"><name>Station: Port Henry</name><desc>Mile 14.6, 0.1 mi off route.</desc><sym>Train</sym></wpt>
  <wpt lat="44.18717" lon="-73.45189"><name>Station: Westport</name><desc>Mile 25.6, 0.8 mi off route.</desc><sym>Train</sym></wpt>
  <trk><name>Ticonderoga, NY to Burlington, VT (via Essex ferry)</name><desc>60.7 mi (97.7 km), about +2,500 ft. Routed on OpenStreetMap along the official trails.</desc><trkseg>
