<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="mtl_bike tools/build.py" xmlns="http://www.topografix.com/GPX/1/1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">
  <metadata><name>7-Day Tour (Sunday to Saturday)</name><desc>460.6 mi total. For bike computers, prefer the one-file-per-day GPX files in gpx/.</desc></metadata>
  <wpt lat="41.27065" lon="-73.78054"><name>Lunch: Trailside Cafe</name><desc>Mile 47.1. 1807 Commerce St, Yorktown Heights, NY. (914) 302-7331. Beside the North County Trailway. Smoothies, paninis, wraps. Sunday hours listed as 8 AM to 3 or 4 PM (sources disagree): call ahead.</desc><sym>Restaurant</sym></wpt>
  <wpt lat="41.40567" lon="-73.58022"><name>Hotel: Heidi's Inn</name><desc>Mile 67.5. 1270 Route 22, Brewster, NY. (845) 279-8011. Motel on NY-22, about 3 mi past the end of the Putnam Trailway (through Brewster village). Confirm bike storage when booking.</desc><sym>Lodging</sym></wpt>
  <wpt lat="41.38536" lon="-73.58489"><name>Hotel: Comfort Inn Brewster</name><desc>Mile 67.0, 1.1 mi off route. 7-11 Peach Lake Rd, Brewster, NY. (845) 363-0974. About 2 mi east of Brewster village near I-84. Free hot breakfast.</desc><sym>Lodging</sym></wpt>
  <wpt lat="41.27347" lon="-73.78083"><name>Bike: Yorktown Cycles</name><desc>Mile 47.3. 1899 Commerce St, Yorktown Heights, NY. (914) 245-5504. Next to the trail. CLOSED Sundays and Mondays (open Tue to Sat 10 to 5), so it is not available on a Sunday Day 1.</desc><sym>Bike Trail</sym></wpt>
  <wpt lat="41.44300" lon="-73.57600"><name>Bike: Route 22 Cycles</name><desc>Mile 67.5, 2.6 mi off route. 2237 Route 22, Brewster, NY. (845) 784-6166. Hours not verified: call before relying on it.</desc><sym>Bike Trail</sym></wpt>
  <wpt lat="41.42620" lon="-73.58000"><name>Bike: Ski Haus (bikes)</name><desc>Mile 67.5, 1.4 mi off route. 1611 Route 22, Brewster, NY. (845) 279-3100. Listed Wed to Fri 11 to 6, Sat 11 to 5; closed Sun to Tue.</desc><sym>Bike Trail</sym></wpt>
  <wpt lat="41.39471" lon="-73.61970"><name>Station: Brewster station</name><desc>Mile 65.2, 0.1 mi off route.</desc><sym>Train</sym></wpt>
  <wpt lat="41.39435" lon="-73.61993"><name>Station: Brewster</name><desc>Mile 65.2, 0.1 mi off route.</desc><sym>Train</sym></wpt>
  <wpt lat="41.92746" lon="-73.91133"><name>Lunch: Bread Alone Bakery &amp; Cafe</name><desc>Mile 59.7. 45 E Market St, Rhinebeck, NY. . Breakfast and lunch daily; listed open Mondays 7 AM to 5 PM.</desc><sym>Restaurant</sym></wpt>
  <wpt lat="42.24871" lon="-73.78506"><name>Hotel: Hudson Whaler Hotel (formerly The Barlow)</name><desc>Mile 89.6. 542 Warren St, Hudson, NY. (518) 217-4334. The Barlow Hotel was sold and reopened as the Hudson Whaler: same building, new name and phone number.</desc><sym>Lodging</sym></wpt>
  <wpt lat="42.25306" lon="-73.79604"><name>Hotel: The Wick, Hudson (Tribute Portfolio)</name><desc>Mile 88.9, 0.2 mi off route. 41 Cross St, Hudson, NY. (518) 249-6825. Near the Hudson Amtrak station.</desc><sym>Lodging</sym></wpt>
  <wpt lat="41.58548" lon="-73.80699"><name>Bike: Bikeway at Hopewell Depot</name><desc>Mile 27.8. Hopewell Depot, Dutchess Rail Trail, Hopewell Junction, NY. (845) 463-4000. Seasonal rentals and repairs at the trailhead; main line is Bikeway's Wappingers Falls shop. Call for October hours.</desc><sym>Bike Trail</sym></wpt>
  <wpt lat="41.92749" lon="-73.91388"><name>Bike: Rhinebeck Bicycle Shop</name><desc>Mile 59.9. 10 Garden St, Rhinebeck, NY. (845) 876-4025. Repairs, parts, rentals. One block from Bread Alone. Call for hours.</desc><sym>Bike Trail</sym></wpt>
  <wpt lat="42.25278" lon="-73.79132"><name>Bike: Steiner's Sports</name><desc>Mile 89.2. 301 Warren St, Hudson, NY. (518) 828-5063. Bike sales and service. Listed Mon to Fri 10 to 6, Sat 10 to 5, Sun from 11.</desc><sym>Bike Trail</sym></wpt>
  <wpt lat="41.70704" lon="-73.93802"><name>Station: Poughkeepsie</name><desc>Mile 41.0, 0.5 mi off route.</desc><sym>Train</sym></wpt>
  <wpt lat="42.25407" lon="-73.79778"><name>Station: Hudson</name><desc>Mile 88.9, 0.3 mi off route.</desc><sym>Train</sym></wpt>
  <wpt lat="42.79009" lon="-73.67877"><name>Lunch: Don &amp; Paul's Coffee Shoppe</name><desc>Mile 52.0. 68 Broad St, Waterford, NY. . Diner on the route by the Waterford canal harbor. Listed Mon to Sat 7 AM to 7:30 PM, Sun 7 AM to 2 PM.</desc><sym>Restaurant</sym></wpt>
  <wpt lat="43.10000" lon="-73.58150"><name>Hotel: Dovegate Inn</name><desc>Mile 75.9. 184 Broad St, Schuylerville, NY. (518) 695-3699. Historic 1800s B&amp;B right on Broad St in Schuylerville village center. Booking ahead recommended (limited rooms); vacation rentals/Airbnbs also available in town or nearby Greenwich.</desc><sym>Lodging</sym></wpt>
  <wpt lat="42.41800" lon="-73.67000"><name>Bike: Steiner's Sports (Valatie)</name><desc>Mile 15.5, 0.5 mi off route. 3455 Route 9, Valatie, NY. (518) 784-3663. In Valatie, just off the AHET around mile 15. Listed Mon to Wed 10 to 6, Thu and Fri 10 to 8, Sat 9 to 5, Sun 11 to 4.</desc><sym>Bike Trail</sym></wpt>
  <wpt lat="42.64125" lon="-73.74129"><name>Station: Albany-Rensselaer</name><desc>Mile 37.5, 0.1 mi off route.</desc><sym>Train</sym></wpt>
  <wpt lat="43.54997" lon="-73.39814"><name>Lunch: Stewart's Shops #211</name><desc>Mile 38.6, 0.3 mi off route. 60 Poultney St, Whitehall, NY. . Convenience store with hot food and coffee. The reliable food stop in Whitehall.</desc><sym>Restaurant</sym></wpt>
  <wpt lat="43.85829" lon="-73.42782"><name>Hotel: Best Western Plus Ticonderoga Inn &amp; Suites</name><desc>Mile 64.6. 260 Burgoyne Rd, Ticonderoga, NY. (518) 585-2378. On the south side of town, right on the route.</desc><sym>Lodging</sym></wpt>
  <wpt lat="43.41500" lon="-73.49100"><name>Bike: Walker's Farm, Home &amp; Tack</name><desc>Mile 25.6, 0.2 mi off route. 5565 State Route 4, Fort Ann, NY. (518) 639-5223. Farm and hardware store, NOT a bike shop: basic tools and supplies only. Listed Mon to Fri 8 to 6, Sat 8 to 5, Sun 9 to 4.</desc><sym>Bike Trail</sym></wpt>
  <wpt lat="43.33163" lon="-73.63583"><name>Bike: Rick's Bike Shop</name><desc>Mile 15.6, 4.7 mi off route. 368 Ridge Rd, Queensbury, NY. (518) 793-8986. Full shop, but about 5 mi west of the route near Fort Edward. Mon to Fri 10 to 6, Sat 10 to 5, closed Sun.</desc><sym>Bike Trail</sym></wpt>
  <wpt lat="43.26976" lon="-73.58040"><name>Station: Fort Edward-Glens Falls</name><desc>Mile 13.4, 0.1 mi off route.</desc><sym>Train</sym></wpt>
  <wpt lat="43.55477" lon="-73.40323"><name>Station: Whitehall</name><desc>Mile 38.8, 0.0 mi off route.</desc><sym>Train</sym></wpt>
  <wpt lat="44.31005" lon="-73.35154"><name>Lunch: Pink Pig Cafe</name><desc>Mile 38.4. 2750 Essex Rd, Essex, NY. (518) 962-8833. Next to the ferry dock. Hours are limited in the fall (one listing shows Fri to Sun hours and closed Mon to Wed; Thursday is unclear): call ahead. The Essex Ice Cream Cafe is summer-only, and 'The Cup Cafe' from earlier drafts does not appear to exist.</desc><sym>Restaurant</sym></wpt>
  <wpt lat="44.69771" lon="-73.49193"><name>Hotel: Best Western Plus Plattsburgh</name><desc>Mile 72.5. 446 Route 3, Plattsburgh, NY. (518) 561-7750. On Route 3 by I-87 exit 37, about 2 mi west of downtown.</desc><sym>Lodging</sym></wpt>
  <wpt lat="44.69935" lon="-73.47864"><name>Bike: Maui North Ski, Bike &amp; Board</name><desc>Mile 71.7, 0.2 mi off route. 316 Cornelia St, Plattsburgh, NY. (518) 563-7245. Full-service shop on the route into town. Listed Mon to Fri 10 to 6, Sat 10 to 5, Sun 12 to 4.</desc><sym>Bike Trail</sym></wpt>
  <wpt lat="44.04761" lon="-73.45925"><name>Food: Stewart's Shops #103</name><desc>Mile 15.0. 4308 Main St, Port Henry, NY. (518) 546-3025. Guaranteed food and water on Day 5. Top up here.</desc><sym>Convenience Store</sym></wpt>
  <wpt lat="44.50652" lon="-73.48346"><name>Food: Stewart's Shops</name><desc>Mile 55.9, 0.2 mi off route. 1774 Main St, Keeseville, NY. . Backup food stop on the route in Keeseville.</desc><sym>Convenience Store</sym></wpt>
  <wpt lat="44.04233" lon="-73.45883"><name>Station: Port Henry</name><desc>Mile 14.6, 0.1 mi off route.</desc><sym>Train</sym></wpt>
  <wpt lat="44.18717" lon="-73.45189"><name>Station: Westport</name><desc>Mile 25.6, 0.8 mi off route.</desc><sym>Train</sym></wpt>
  <wpt lat="44.69672" lon="-73.44645"><name>Station: Plattsburgh</name><desc>Mile 70.3, 0.2 mi off route.</desc><sym>Train</sym></wpt>
  <wpt lat="44.99315" lon="-73.36424"><name>Lunch: Lakeside Coffee Roasters</name><desc>Mile 28.1. 109 Lake St, Rouses Point, NY. (518) 297-5600. Last US cafe before the border. Paninis, quiche, soups. Listed Tue to Fri 7:30 AM to 2 PM (one source says Fri closes 1:30), Sat and Sun 8 to 2, closed Mon. The Lake Street Cafe &amp; Bakery listed in earlier drafts closed in Oct 2025.</desc><sym>Restaurant</sym></wpt>
  <wpt lat="45.32482" lon="-73.26641"><name>Hotel: Quality Hotel Centre de Congrès</name><desc>Mile 54.7. 725 Boul. du Séminaire N, Saint-Jean-sur-Richelieu, QC. +1 (450) 300-5177. North side of town, near the canal. Choice Hotels toll-free: 1-800-667-3815.</desc><sym>Lodging</sym></wpt>
  <wpt lat="45.32391" lon="-73.26475"><name>Hotel: Auberge Harris</name><desc>Mile 54.4. 576 Rue Champlain, Saint-Jean-sur-Richelieu, QC. +1 (450) 348-3821. Riverside inn close to the start of the canal path. Toll-free 1-800-668-3821.</desc><sym>Lodging</sym></wpt>
  <wpt lat="45.35408" lon="-73.29597"><name>Bike: Cycle LM</name><desc>Mile 54.7, 2.4 mi off route. 270 Boul. Saint-Luc, Saint-Jean-sur-Richelieu, QC. . Bike shop with a repair workshop, about 2.4 mi west of the route. Replaces 'Performance Bégin', which could not be found. Phone not verified: see cyclelm.com.</desc><sym>Bike Trail</sym></wpt>
  <wpt lat="45.01030" lon="-73.37086"><name>BORDER: Rouses Point–Lacolle 223</name><desc>Mile 29.4. Open 8 AM to 8 PM daily (both sides). Passport, EDL or NEXUS. No cannabis.</desc><sym>Crossing</sym></wpt>
  <wpt lat="44.99500" lon="-73.37117"><name>Station: Rouses Point</name><desc>Mile 28.3, 0.3 mi off route.</desc><sym>Train</sym></wpt>
  <wpt lat="45.44423" lon="-73.26440"><name>Lunch: Boulangerie du Vieux-Chambly</name><desc>Mile 13.8, 0.2 mi off route. 2403 Av. Bourgogne, Chambly, QC. +1 (450) 447-9991. Bakery and cafe on the route, about 0.5 mi before Fort Chambly. Sandwiches and pastries. Replaces Fourquet Fourchette, which has closed.</desc><sym>Restaurant</sym></wpt>
  <wpt lat="45.50447" lon="-73.56234"><name>Hotel: Hôtel Monville</name><desc>Mile 35.5, 0.4 mi off route. 1041 Rue de Bleury, Montréal, QC. +1 (514) 379-2000. Downtown, about 0.5 mi from Place Jacques-Cartier. Ask about bike storage when booking.</desc><sym>Lodging</sym></wpt>
  <wpt lat="45.50020" lon="-73.56848"><name>Hotel: Fairmont The Queen Elizabeth</name><desc>Mile 35.3, 0.7 mi off route. 900 Boul. René-Lévesque O, Montréal, QC. +1 (514) 861-3511. Above Gare Centrale. Unboxed bikes still cannot board Amtrak here.</desc><sym>Lodging</sym></wpt>
  <wpt lat="45.50583" lon="-73.55314"><name>Bike: Ça Roule Montréal / Montreal on Wheels</name><desc>Mile 35.6. 27 Rue de la Commune E, Montréal, QC. +1 (514) 866-0633. Rental and repair shop at the finish in Old Montreal. October hours listed 10 AM to 5 PM daily.</desc><sym>Bike Trail</sym></wpt>
  <wpt lat="45.53945" lon="-73.61759"><name>Bike: Bicycles Quilicot (Villeray)</name><desc>Mile 35.8, 3.8 mi off route. 7341 Rue Saint-Denis, Montréal, QC. +1 (514) 303-4118. Full shop, 4 mi north of downtown. Call ahead to confirm bike boxes are available.</desc><sym>Bike Trail</sym></wpt>
  <wpt lat="45.53030" lon="-73.66200"><name>Bike: MEC Montréal (Marché Central)</name><desc>Mile 35.8, 5.5 mi off route. 8989 Boul. de l'Acadie, Montréal, QC. +1 (514) 788-5878. Outdoor store with bike service. Earlier drafts gave a Saint-Denis address; that is wrong.</desc><sym>Bike Trail</sym></wpt>
  <wpt lat="45.52493" lon="-73.52192"><name>Station: Longueuil–Université-de-Sherbrooke</name><desc>Mile 28.8, 0.1 mi off route.</desc><sym>Train</sym></wpt>
  <trk><name>Day 1 (Sunday Oct 4): NYC (Battery Park) to Brewster, NY</name><desc>67.5 mi (108.6 km), about +2,100 ft. Routed on OpenStreetMap along the official trails.</desc><trkseg>
