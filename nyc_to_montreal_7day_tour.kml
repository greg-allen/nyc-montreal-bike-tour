<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
<Document>
  <name>NYC to Montreal 7-Day Gentler Bicycle Tour (Sunday to Saturday)</name>
  <description>Empire State Trail, Lake Champlain Coast, Richelieu River &amp; Chambly Canal (Recommended for October Daylight)</description>
  <Folder>
    <name>Sunday • Day 1: NYC to Brewster / Carmel</name>
    <Placemark>
      <name>Sunday Route Track (60.0 mi)</name>
      <description>95% Paved Traffic-Free Rail Trail (Hudson River Greenway, South/North County, Putnam)</description>
      <LineString>
        <tessellate>1</tessellate>
        <coordinates>
          -74.017,40.7033,0
          -74.0048,40.758,0
          -73.9404,40.8517,0
          -73.9215,40.8785,0
          -73.886,40.8978,0
          -73.8765,40.9312,0
          -73.8582,40.9985,0
