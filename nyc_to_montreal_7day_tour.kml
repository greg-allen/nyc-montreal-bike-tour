  <Folder>
    <name>Friday • Day 6: Plattsburgh to Saint-Jean-sur-Richelieu, QC (Canada)</name>
    <Placemark>
      <name>Friday Route Track (50.0 mi)</name>
      <description>70% Flat Paved Rural Roads (US-9 &amp; QC-223), 30% Local Cycle Lanes</description>
      <LineString>
        <tessellate>1</tessellate>
        <coordinates>
          -73.4529,44.6995,0
          -73.4326,44.8911,0
