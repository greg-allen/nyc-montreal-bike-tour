      </LineString>
    </Placemark>
    <Placemark>
      <name>🛂 Canadian Border Crossing (Lacolle / QC-223)</name>
      <description>International Border Crossing. Valid Passport, EDL, or NEXUS required! Zero cannabis.</description>
      <Point><coordinates>-73.367,45.0064,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>🥪 Lakeside Bakery &amp; Cafe (Rouses Point)</name>
      <description>Last American stop before customs! Fresh pastries, espresso, sandwiches. (Mile 24)</description>
      <Point><coordinates>-73.3646,44.9939,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>🏨 Quality Hotel Centre de Congrès</name>
      <description>725 Boul. du Séminaire N, Saint-Jean-sur-Richelieu, QC | +1 (450) 515-5755 | Full hotel, pool, dining, bike storage.</description>
      <Point><coordinates>-73.264,45.312,0</coordinates></Point>
    </Placemark>
  </Folder>
