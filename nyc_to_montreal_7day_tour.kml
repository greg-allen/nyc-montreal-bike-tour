          -73.7994,41.1398,0
          -73.785,41.2052,0
          -73.782,41.272,0
          -73.742,41.3485,0
          -73.6171,41.3973,0
        </coordinates>
      </LineString>
    </Placemark>
    <Placemark>
      <name>🥪 Trailside Cafe (Yorktown Heights)</name>
      <description>Directly alongside the rail trail! Fresh fruit smoothies, paninis, wraps, outdoor tables. (Mile 38)</description>
      <Point><coordinates>-73.782,41.272,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>🏨 Heidi's Inn</name>
      <description>1270 Route 22, Brewster, NY | (845) 279-8011 | Cyclist-friendly motel, convenient ground-floor rooms with bike roll-in.</description>
      <Point><coordinates>-73.595,41.411,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>🏨 Comfort Inn Brewster</name>
      <description>7-11 Peach Lake Rd, Brewster, NY | (845) 483-7848 | Spacious rooms, indoor pool, complimentary hot breakfast.</description>
      <Point><coordinates>-73.582,41.385,0</coordinates></Point>
    </Placemark>
  </Folder>
